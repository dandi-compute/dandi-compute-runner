# The workflow triggers and the squeue snapshot record themselves in the global logs repository
# (/orcd/data/dandi/001/dandi-compute/dandi-compute-global-logs, see launcher/record.sh).
# Each trigger checks for work from this login node and starts its GitHub workflow only when there
# is some (see launcher/trigger_github_action_cron.sh).
*/15 * * * * /orcd/data/dandi/001/dandi-compute/dandi-compute-runner/launcher/record.sh logs dispatch-trigger -- /orcd/data/dandi/001/dandi-compute/dandi-compute-runner/launcher/dispatch_github_action_cron.sh > /dev/null 2>&1
0 0 * * * /orcd/data/dandi/001/dandi-compute/dandi-compute-runner/launcher/record.sh logs create-trigger -- /orcd/data/dandi/001/dandi-compute/dandi-compute-runner/launcher/create_github_action_cron.sh > /dev/null 2>&1

# For whatever reason, this particular job is sensitive to the usage of `/bin/bash -l` in order to 'behave properly'. Otherwise the SLURM job does run, the self-hosted runner is active, but the conda init does not trigger and so no environment is found.
*/1 * * * * /bin/bash -l -c 'flock -n /orcd/data/dandi/001/dandi-compute/flocks/submitter.lock -c "/orcd/data/dandi/001/dandi-compute/dandi-compute-runner/launcher/guarded-submit -N DANDI-Compute-Submitter -- sbatch --output /dev/null --error=/dev/null /orcd/data/dandi/001/dandi-compute/dandi-compute-runner/launcher/launch_submitter.sh" || echo "$(date): lock held, skipping submit"' > /dev/null 2>&1

# A squeue snapshot every 5 minutes, recorded under monitor/ (see launcher/monitor.sh).
*/5 * * * * /bin/bash -l -c '/orcd/data/dandi/001/dandi-compute/dandi-compute-runner/launcher/monitor.sh' > /dev/null 2>&1

# A disk usage snapshot every 30 minutes, recorded under disk/ (see launcher/disk.sh).
*/30 * * * * /bin/bash -l -c '/orcd/data/dandi/001/dandi-compute/dandi-compute-runner/launcher/disk.sh' > /dev/null 2>&1

# Every Sunday at 04:00, clear the Apptainer blobs older than a week, the dandi-cli logs and the
# Bazel cache from the home directory, recorded under logs/ (see launcher/clean_home.sh).
0 4 * * 0 /orcd/data/dandi/001/dandi-compute/dandi-compute-runner/launcher/clean_home.sh > /dev/null 2>&1

# The S3 backup jobs of simple-s3-backup, each submission recorded under logs/ and each job's own
# output kept in /orcd/data/dandi/001/backup/logs/ (see launcher/backup.sh). The Check backup
# workflow emails when one of them fails or the blob mirror stops growing. The checksums job runs
# once the blob backup's 12 hours are up, and fails when a mirrored blob does not match the bucket.
0 22 * * * /orcd/data/dandi/001/dandi-compute/dandi-compute-runner/launcher/backup.sh blobs > /dev/null 2>&1
#0 19 * * 0,3 /orcd/data/dandi/001/dandi-compute/dandi-compute-runner/launcher/backup.sh zarr > /dev/null 2>&1  # Zarr was disabled in May 2026
0 18 * * * /orcd/data/dandi/001/dandi-compute/dandi-compute-runner/launcher/backup.sh nonblobs > /dev/null 2>&1
0 6 * * * /orcd/data/dandi/001/dandi-compute/dandi-compute-runner/launcher/backup.sh dashboard > /dev/null 2>&1
0 10 * * * /orcd/data/dandi/001/dandi-compute/dandi-compute-runner/launcher/backup.sh checksums > /dev/null 2>&1

# Every hour, the ledger of blobs whose checksum did not match the bucket, kept by the checksums job,
# is copied to the checksum-mismatches branch of the global logs when it has changed (see
# launcher/publish_checksum_mismatches.sh).
17 * * * * /orcd/data/dandi/001/dandi-compute/dandi-compute-runner/launcher/publish_checksum_mismatches.sh > /dev/null 2>&1
